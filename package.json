{
  "name": "openshare",
  "version": "2.0.0",
  "description": "Secure, temporary file sharing platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "docker:build": "docker build -t openshare .",
    "docker:run": "docker run -p 4001:4001 openshare"
  },
  "keywords": ["file-sharing", "temporary", "privacy", "secure"],
  "author": "OpenShare Contributors",
  "license": "Apache-2.0",
  "dependencies": {
    "helmet": "^8.0.0",
    "express-rate-limit": "^7.4.1",
    "multer": "^2.0.0-rc.4",
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "compression": "^1.7.5",
    "winston": "^3.17.0",
    "joi": "^17.13.3",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "jest": "^29.7.0",
    "supertest": "^7.1.3",
    "eslint": "^9.17.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}